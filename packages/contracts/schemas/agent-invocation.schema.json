{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-project-office.local/schemas/agent-invocation.schema.json",
  "$defs": {
    "InvocationLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        },
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "InvocationLimits",
      "type": "object"
    },
    "InvocationMode": {
      "enum": [
        "sync",
        "stream",
        "async_job"
      ],
      "title": "InvocationMode",
      "type": "string"
    },
    "SandboxPolicy": {
      "additionalProperties": false,
      "description": "OS-level isolation for adapters that run local processes (spec \u00a713).\n\nWith ``mode='bwrap'`` the process sees the host filesystem read-only, can\nwrite only to ``writable`` paths, and ``hidden`` paths are masked (empty\ndir / empty file). Network stays available when ``network`` is true\n(provider CLIs must reach their API).",
      "properties": {
        "mode": {
          "default": "none",
          "enum": [
            "none",
            "bwrap"
          ],
          "title": "Mode",
          "type": "string"
        },
        "writable": {
          "items": {
            "type": "string"
          },
          "title": "Writable",
          "type": "array"
        },
        "readable": {
          "description": "Re-exposed read-only inside hidden paths.",
          "items": {
            "type": "string"
          },
          "title": "Readable",
          "type": "array"
        },
        "hidden": {
          "items": {
            "type": "string"
          },
          "title": "Hidden",
          "type": "array"
        },
        "network": {
          "default": true,
          "title": "Network",
          "type": "boolean"
        }
      },
      "title": "SandboxPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "invocation_id": {
      "title": "Invocation Id",
      "type": "string"
    },
    "idempotency_key": {
      "description": "Re-dispatch with the same key must not start a second run.",
      "title": "Idempotency Key",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/InvocationMode"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "context_refs": {
      "description": "content_ref / artifact URIs.",
      "items": {
        "type": "string"
      },
      "title": "Context Refs",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/InvocationLimits"
    },
    "workdir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Directory the agent may write to; its new files are artifacts.",
      "title": "Workdir"
    },
    "read_dirs": {
      "description": "Extra directories the agent may read.",
      "items": {
        "type": "string"
      },
      "title": "Read Dirs",
      "type": "array"
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "JSON Schema the final output must match (structured output).",
      "title": "Output Schema"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxPolicy"
    }
  },
  "required": [
    "invocation_id",
    "idempotency_key",
    "project_id",
    "agent_id",
    "trace_id",
    "mode",
    "instructions"
  ],
  "title": "AgentInvocation",
  "type": "object"
}
