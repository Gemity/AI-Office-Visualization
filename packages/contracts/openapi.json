  "components": {
    "schemas": {
      "AdapterInfo": {
        "properties": {
          "adapter_type": {
            "type": "string",
            "title": "Adapter Type"
          },
          "default_manifest": {
            "$ref": "#/components/schemas/CapabilityManifest"
          }
        },
        "type": "object",
        "required": [
          "adapter_type",
          "default_manifest"
        ],
        "title": "AdapterInfo"
      },
      "AgentCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "adapter_type": {
            "type": "string",
            "title": "Adapter Type"
          },
          "role": {
            "type": "string",
            "enum": [
              "orchestrator",
              "worker"
            ],
            "title": "Role"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config",
            "description": "Adapter config (non-secret), see adapter docs."
          }
        },
        "type": "object",
        "required": [
          "name",
          "adapter_type",
          "role"
        ],
        "title": "AgentCreate"
      },
      "AgentOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "adapter_type": {
            "type": "string",
            "title": "Adapter Type"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "is_active_orchestrator": {
            "type": "boolean",
            "title": "Is Active Orchestrator"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "current_runs": {
            "items": {
              "$ref": "#/components/schemas/CurrentRun"
            },
            "type": "array",
            "title": "Current Runs"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "adapter_type",
          "provider",
          "role",
          "enabled",
          "is_active_orchestrator",
          "capabilities",
          "current_runs",
          "created_at"
        ],
        "title": "AgentOut"
      },
      "ArtifactOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "uri": {
            "type": "string",
            "title": "Uri"
          },
          "checksum": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checksum"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "task_id",
          "run_id",
          "type",
          "uri",
          "checksum",
          "version",
          "created_at"
        ],
        "title": "ArtifactOut"
      },
      "Capability": {
        "type": "string",
        "enum": [
          "chat",
          "code",
          "image",
          "audio",
          "3d",
          "tool_call",
          "async_job"
        ],
        "title": "Capability"
      },
      "CapabilityManifest": {
        "properties": {
          "adapter_type": {
            "type": "string",
            "title": "Adapter Type",
            "description": "Stable adapter identifier, e.g. 'claude-agent-sdk'."
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "type": "array",
            "minItems": 1,
            "title": "Capabilities"
          },
          "invocation_modes": {
            "items": {
              "$ref": "#/components/schemas/InvocationMode"
            },
            "type": "array",
            "minItems": 1,
            "title": "Invocation Modes"
          },
          "required_permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Permissions"
          },
          "supported_artifact_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Artifact Types"
          },
          "cost_model": {
            "$ref": "#/components/schemas/CostModel"
          },
          "observability_level": {
            "$ref": "#/components/schemas/ObservabilityLevel"
          },
          "supports_cancel": {
            "type": "boolean",
            "title": "Supports Cancel",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
